{
  "name": "continua",
  "version": "0.1.0",
  "private": true,
  "description": "Continuity intelligence for care coordinators. Synthetic demonstration only.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:spec": "tsx scripts/validate-spec.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "check:safety": "tsx scripts/check-safety.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "generate:data": "tsx scripts/generate-synthetic-data.ts",
    "validate:dataset": "tsx scripts/validate-dataset.ts",
    "check:truth": "tsx scripts/check-truth.ts",
    "audit:synthetic": "tsx scripts/audit-synthetic-safety.ts",
    "check:leakage": "tsx scripts/check-leakage.ts",
    "hash:dataset": "tsx scripts/hash-dataset.ts",
    "characterize:data": "tsx scripts/characterize-dataset.ts",
    "verify:determinism": "tsx scripts/verify-determinism.ts",
    "build:benchmark": "tsx scripts/build-benchmark-contracts.ts",
    "eval": "tsx scripts/eval.ts",
    "validate:benchmark": "tsx scripts/validate-benchmark.ts",
    "audit:benchmark-leakage": "tsx scripts/audit-benchmark-leakage.ts",
    "hash:benchmark": "tsx scripts/hash-benchmark.ts",
    "validate:clinical-events": "tsx scripts/validate-clinical-events.ts",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run validate:spec && npm run validate:data && npm run validate:dataset && npm run check:truth && npm run audit:synthetic && npm run check:leakage && npm run validate:env && npm run check:safety && npm run check:secrets && npm run hash:dataset && npm run validate:benchmark && npm run audit:benchmark-leakage && npm run hash:benchmark && npm run validate:clinical-events"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.10.7",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
