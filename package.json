{
  "name": "continua",
  "version": "0.1.0",
  "private": true,
  "description": "Continuity intelligence for care coordinators. Synthetic demonstration only.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:spec": "tsx scripts/validate-spec.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "check:safety": "tsx scripts/check-safety.ts",
    "verify:determinism": "tsx scripts/verify-determinism.ts",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run validate:spec && npm run validate:data && npm run validate:env && npm run check:safety"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.10.7",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
