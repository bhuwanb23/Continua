# Copy to .env.local for local development.
# Demo mode boots with NO external credentials.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Continua
CONTINUA_DEMO_MODE=true

# Frozen benchmark clock. Do not read the system clock in clinical paths.
CONTINUA_EVALUATION_AS_OF_DATE=2026-06-05

# Optional: only needed for live extraction in later phases.
# Never prefix secrets with NEXT_PUBLIC_.
LLM_PROVIDER=
LLM_API_KEY=

# Optional: not required for the Phase 1 shell.
SUPABASE_URL=
SUPABASE_ANON_KEY=
